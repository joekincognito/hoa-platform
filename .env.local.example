# Copy to .env.local and fill in values for each deploy.
# Never commit .env.local.

# --- Supabase ---
# From https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only — keeps full DB access; never expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (email) ---
# https://resend.com/api-keys
RESEND_API_KEY=
# Must match a verified domain in Resend.
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME="Example HOA"
EMAIL_REPLY_TO=board@example.com

# Recipient for contact-form submissions + admin alerts.
ADMIN_NOTIFICATION_EMAIL=

# --- SMS broadcasts (optional; only needed if siteConfig.features.smsEnabled = true) ---
# Requires A2P 10DLC registration with The Campaign Registry (~1-2 weeks).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
